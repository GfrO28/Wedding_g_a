# Neon (Postgres) — https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Correo del panel (códigos de ingreso, avisos, invitaciones): cuenta de Gmail con
# verificación en dos pasos y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords). Las personas con acceso se manejan
# en el panel → Seguridad; para cambiar una contraseña sin entrar:
# node scripts/admin-password.mjs
GMAIL_USER="cuenta@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Cloudflare R2 — https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública del bucket. La usan las fotos, la música y las imágenes del sobre
# subidas desde el panel: sin ella, el sobre vuelve a sus imágenes originales.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
