# Neon (Postgres) — https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin (panel de los novios en /admin)
ADMIN_PASSWORD="elegi-una-contrasena-segura"

# Cloudflare R2 — https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# URL pública del bucket. La usan las fotos, la música y las imágenes del sobre
# subidas desde el panel: sin ella, el sobre vuelve a sus imágenes originales.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
